import { chromium } from 'playwright';
import fs from 'fs';
const exe = '/usr/bin/google-chrome';
const args = ['--no-sandbox','--disable-dev-shm-usage','--enable-unsafe-swiftshader','--disable-backgrounding-occluded-windows'];
async function cap(name, viewport, url, hideCenter) {
  const browser = await chromium.launch({ executablePath: exe, headless: true, args });
  const page = await browser.newPage({ viewport });
  await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 15000 });
  await page.waitForTimeout(4000);
  if (hideCenter) {
    await page.evaluate(() => { const c=document.getElementById('center'); if(c) c.style.display='none'; });
    await page.waitForTimeout(800);
  }
  await page.evaluate(() => new Promise(r => requestAnimationFrame(()=>requestAnimationFrame(r))));
  const dataUrl = await page.evaluate(() => { const c=document.querySelector('canvas'); return c ? c.toDataURL('image/png') : null; });
  if (!dataUrl) throw new Error(name+': no canvas');
  fs.writeFileSync('screenshots/'+name, Buffer.from(dataUrl.split(',')[1],'base64'));
  const st = fs.statSync('screenshots/'+name);
  console.log(name, (st.size/1024).toFixed(1)+'KB');
  await browser.close();
}
await cap('final-menu.png', {width:1280,height:720}, 'http://127.0.0.1:3000/aaa-fps/?capture', false);
